# Records docs/demo.gif: hover EPUBs in Yazi and watch the covers appear.
#
#   vhs docs/demo.tape
#
# Requires vhs, yazi, ImageMagick (magick) and zip. The books are generated by
# make-demo-epub.sh, so the recording contains no copyrighted material.
# Yazi runs against a throwaway YAZI_CONFIG_HOME holding only this plugin; your
# own theme and flavors are reused when present, otherwise Yazi's defaults are.

Output docs/demo.gif

Require yazi
Require magick
Require zip

Set Shell "bash"
Set FontFamily "Hack Nerd Font Mono"
Set FontSize 17
Set Width 1200
Set Height 720
Set Padding 12
Set Framerate 12
Set Theme "Catppuccin Mocha"
Set WindowBar Colorful
Set TypingSpeed 1ms

Hide
Type `repo_root="$(pwd -P)"`
Enter
Type `demo_root="$(cd /tmp && pwd -P)/epub-preview-demo"`
Enter
Type `rm -rf "$demo_root"`
Enter
Type `mkdir -p "$demo_root/config/plugins/epub-preview.yazi"`
Enter
Type `cp "$repo_root/main.lua" "$demo_root/config/plugins/epub-preview.yazi/main.lua"`
Enter
Type `cp -R "$repo_root/assets" "$demo_root/config/plugins/epub-preview.yazi/assets"`
Enter
Type `printf '%s\n' '[mgr]' 'ratio = [1, 2, 4]' '' '[[plugin.prepend_previewers]]' 'mime = "application/epub+zip"' 'run = "epub-preview"' > "$demo_root/config/yazi.toml"`
Enter
Type `real="$HOME/.config/yazi"; [ -f "$real/theme.toml" ] && [ -d "$real/flavors" ] && cp "$real/theme.toml" "$demo_root/config/" && cp -R "$real/flavors" "$demo_root/config/"`
Enter
Type `sh "$repo_root/docs/make-demo-epub.sh" "$demo_root/books"`
Enter
Type `export YAZI_CONFIG_HOME="$demo_root/config"`
Enter
Type `cd "$demo_root/books"`
Enter
Type "clear"
Enter
Type "yazi"
Enter
Sleep 3s
Show

Sleep 1s
j
Sleep 1500ms
j
Sleep 1500ms
j
Sleep 3s
